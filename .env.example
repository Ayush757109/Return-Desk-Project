# ReturnDesk — required environment variables (no real secrets in this file)
# Copy to .env for local development, or set the same names in your host
# (e.g. Vercel project settings). The frontend never talks to the database
# directly — it only calls /api/* — so no VITE_* database keys are needed.

# Supabase project URL. Used by api/db-client.js and scripts/seed.mjs.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service-role key (SERVER ONLY — full database access).
# Used by api/db-client.js and scripts/seed.mjs. Never expose it to a browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase anon (public) key. Provisioned by the deployment platform;
# not currently required by the app code (kept for future direct-client use).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
